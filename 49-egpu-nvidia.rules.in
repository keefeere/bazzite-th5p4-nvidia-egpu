// Generated from hardware.conf. Permission is limited to the configured
// active local desktop user and the exact eGPU transition services.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "egpu-nvidia-detach.service" ||
         action.lookup("unit") == "egpu-nvidia-hot-attach.service") &&
        action.lookup("verb") == "start" &&
        subject.user == "@DESKTOP_USER@" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
