// Generated by install-service-roles.py. Permission is limited to the configured
// active local desktop user and the exact three profile instances; no wildcards.
polkit.addRule(function(action, subject) {
    var profiles = [
        "egpu-service-roles-profile@gaming-nvidia.service",
        "egpu-service-roles-profile@work-nvidia.service",
        "egpu-service-roles-profile@work-igpu.service"
    ];
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        profiles.indexOf(action.lookup("unit")) >= 0 &&
        action.lookup("verb") == "start" &&
        subject.user == "@DESKTOP_USER@" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
